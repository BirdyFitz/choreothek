{
  "name": "choreothek",
  "productName": "Choreothek",
  "version": "0.9.0",
  "description": "Nachschlagewerk für Choreos, Songs und Rhythmen aus dem eigenen Tanz-Archiv (Jam Sessions, Mixe, Volumes) – Windows-Desktop-App",
  "license": "GPL-3.0-only",
  "author": "Harald Henke",
  "private": true,
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "vite build && electron .",
    "build:renderer": "vite build",
    "start": "electron .",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron test/run.js",
    "ffmpeg:local": "node scripts/ffmpeg.mjs --local",
    "dist": "vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@google/genai": "^2.24.0",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "express": "^4.22.3",
    "music-metadata": "^11.16.1",
    "openai": "^7.23.0",
    "pdf-lib": "^1.17.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@tabler/icons-react": "^3.48.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axios": "^1.20.0",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": false,
    "electron@44.4.5": true,
    "@google/genai": false,
    "protobufjs": false,
    "electron-winstaller": false
  },
  "homepage": "https://choreothek.eu",
  "repository": {
    "type": "git",
    "url": "https://github.com/BirdyFitz/choreothek.git"
  },
  "build": {
    "appId": "eu.choreothek.app",
    "productName": "Choreothek",
    "copyright": "Harald Henke, GPL-3.0",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "dist/renderer/**/*",
      "package.json",
      "LICENSE",
      "!src/**/*.test.js"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "src/server/video/**"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "build/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "*.exe",
          "LICENSE*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Choreothek-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Choreothek",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "BirdyFitz",
        "repo": "choreothek"
      }
    ],
    "electronDist": "node_modules/electron/dist"
  }
}
