# Seiten auch ohne .html erreichbar – die App verlinkt https://choreothek.eu/anleitung#…
RewriteEngine On

# Immer https und ohne www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://choreothek.eu%{REQUEST_URI} [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([a-z-]+)/?$ $1.html [L]

# Hilfevideos der Anleitung (wegen nosniff muss der Typ stimmen)
AddType video/mp4 .mp4

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
